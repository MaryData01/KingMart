# Server configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/kingsmart

# JWT Secrets
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Cloudinary (Optional, will fallback to local base64/mock if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (Optional, will fallback to mock payment session if empty)
STRIPE_SECRET_KEY=

# Paystack (Optional, will fallback to mock payment session if empty)
PAYSTACK_SECRET_KEY=

# Email Settings (Optional, will fallback to Ethereal/console logs if empty)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kingsmart.com
